# Bot by mogent (bot.mogent.tech) - Environment Configuration
PORT=5000
NODE_ENV=production

# Security & Encryption (32-character AES-256 master key)
APP_ENCRYPTION_KEY=mogent-secure-master-key-2026-production-vault-32char
JWT_SECRET=mogent-jwt-secret-key-2026-production-token

# SQLite WAL Database path
SQLITE_DB_PATH=./data/mogent.sqlite

# Bot Runner Mode ('polling' works immediately with zero config; 'webhook' requires valid public domain & SSL)
BOT_RUNNER_MODE=polling

# Super Admin God-Mode Secret Token
GODMODE_SECRET_TOKEN=hkjhl-sadmin-godmode-2026
